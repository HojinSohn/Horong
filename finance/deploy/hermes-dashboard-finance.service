[Unit]
Description=Horong custom-dashboard Plaid finance service
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/root/hermes-dashboard-finance
ExecStart=/root/hermes-dashboard-finance/venv/bin/python -m finance_service.main
Restart=on-failure
RestartSec=2
EnvironmentFile=/root/hermes-dashboard-finance/finance.env
Environment=FINANCE_HOST=100.109.58.59
Environment=FINANCE_PORT=8766
Environment=PLAID_ENV=production
Environment=FINANCE_DB_PATH=/root/hermes-dashboard-finance/finance.db

[Install]
WantedBy=default.target
