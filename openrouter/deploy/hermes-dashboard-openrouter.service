[Unit]
Description=Horong custom-dashboard OpenRouter usage/balance service
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/root/hermes-dashboard-openrouter
ExecStart=/root/hermes-dashboard-openrouter/venv/bin/python -m openrouter_service.main
Restart=on-failure
RestartSec=2
EnvironmentFile=/root/hermes-dashboard-openrouter/openrouter.env
Environment=OPENROUTER_STATUS_HOST=100.109.58.59
Environment=OPENROUTER_STATUS_PORT=8768

[Install]
WantedBy=default.target
