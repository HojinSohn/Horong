[Unit]
Description=Horong custom-dashboard frontend static server
After=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/root/hermes-dashboard-frontend
ExecStart=/usr/bin/python3 /root/hermes-dashboard-frontend/serve.py
Environment=FRONTEND_HOST=100.109.58.59
Environment=FRONTEND_PORT=8770
Environment=FRONTEND_DIST_DIR=/root/hermes-dashboard-frontend/dist
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
